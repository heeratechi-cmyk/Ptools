    "@types/react-google-recaptcha": "^2.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-dropzone": "^20.1.4",
    "react-easy-crop": "^6.2.4",
